-- A small library of theories, the instances that satisfy them, and lemmas
-- proved once and applied at those instances.
--
-- This is the demo the module layer was built for. A theory is a named
-- telescope: its fields are a carrier, the operations on it, and the laws they
-- satisfy, all in one dependent block. A richer theory includes a poorer one,
-- so the hierarchy below runs Semigroup, Monoid, CommMonoid, Group, in the
-- manner of Pollack's dependent records and Sterling's Pterodactyl. A module
-- includes a theory to work in it, and every declaration leaves that module
-- discharged over the fields it used. An instance is a module that fixes those
-- fields to values, so using a theory's lemma at an instance is application.
-- There is no `interpretation` command here, and nothing for one to do.

telescope Semigroup
  (A : 𝕌)
  (mul : A → A → A)
  (assoc : Π (x : A) → Π (y : A) → Π (z : A) → Id(A, mul (mul x y) z, mul x (mul y z)))

-- A monoid is a semigroup with a unit and its laws: the include puts the
-- semigroup's fields first, and the unit's types may mention them.
telescope Monoid include Semigroup
  (unit : A)
  (unitL : Π (x : A) → Id(A, mul unit x, x))
  (unitR : Π (x : A) → Id(A, mul x unit, x))

-- * Working in the theory

-- Everything here is checked with the fields in scope, so it reads as ordinary
-- mathematics, and leaves the module closed over what it used and no more.
module MonoidTheory include Monoid

-- Uses the carrier and the operation. Not the laws, and not the unit.
def square over (A, mul) : A → A := λ x ⇒ mul x x

-- Uses associativity, so it is discharged over that too. The proof is the law
-- at one argument repeated: `square x` unfolds to `mul x x`, so `assoc x x x`
-- already has the type wanted.
def squareAssoc over (A, mul, assoc)
  : Π (x : A) → Id(A, mul (square x) x, mul x (square x))
  := λ x ⇒ assoc x x x

-- A different set of fields again: the unit and its law, and not associativity.
def unitSquare over (A, mul, unit, unitL)
  : Π (x : A) → Id(A, mul unit (square x), square x)
  := λ x ⇒ unitL (square x)

-- * Theories on top of theories

-- Each of these is a theory in its own right, built on Monoid by inclusion,
-- and can itself be included by a further telescope or worked in by a module.
telescope CommMonoid include Monoid
  (comm : Π (x : A) → Π (y : A) → Id(A, mul x y, mul y x))

telescope Group include Monoid
  (inv : A → A)
  (invL : Π (x : A) → Id(A, mul (inv x) x, unit))

module CommMonoidTheory include CommMonoid
def unitFlip over (A, mul, unit, comm)
  : Π (x : A) → Id(A, mul unit x, mul x unit)
  := λ x ⇒ comm unit x

module GroupTheory include Group
def cancelSquare over (A, mul, unit, inv, invL)
  : Π (x : A) → Id(A, mul (inv (mul x x)) (mul x x), unit)
  := λ x ⇒ invL (mul x x)

-- * A carrier, with two monoid structures on it

-- The naturals as Church numerals, which is as much data as a type theory with
-- no data declarations can offer. Addition and multiplication are both monoid
-- operations on them, and every law below holds on the nose, so each is
-- discharged by `refl`. The unit laws need η, which `nf` contracts.
module Church
def Nat : 𝕌 := Π (A : 𝕌) → (A → A) → A → A
def zero : Nat := λ A ⇒ λ f ⇒ λ x ⇒ x
def succ : Nat → Nat := λ n ⇒ λ A ⇒ λ f ⇒ λ x ⇒ f (n A f x)
def one : Nat := succ zero
def two : Nat := succ one
def three : Nat := succ two

def plus : Nat → Nat → Nat := λ m ⇒ λ n ⇒ λ A ⇒ λ f ⇒ λ x ⇒ m A f (n A f x)
def times : Nat → Nat → Nat := λ m ⇒ λ n ⇒ λ A ⇒ λ f ⇒ m A (n A f)

def plusAssoc : Π (a : Nat) → Π (b : Nat) → Π (c : Nat)
              → Id(Nat, plus (plus a b) c, plus a (plus b c))
  := λ a ⇒ λ b ⇒ λ c ⇒ refl (plus (plus a b) c)
def plusUnitL : Π (a : Nat) → Id(Nat, plus zero a, a) := λ a ⇒ refl (a)
def plusUnitR : Π (a : Nat) → Id(Nat, plus a zero, a) := λ a ⇒ refl (a)

def timesAssoc : Π (a : Nat) → Π (b : Nat) → Π (c : Nat)
               → Id(Nat, times (times a b) c, times a (times b c))
  := λ a ⇒ λ b ⇒ λ c ⇒ refl (times (times a b) c)
def timesUnitL : Π (a : Nat) → Id(Nat, times one a, a) := λ a ⇒ refl (a)
def timesUnitR : Π (a : Nat) → Id(Nat, times a one, a) := λ a ⇒ refl (a)

-- * Refinement: fixing the carrier, leaving the structure open

-- `Monoid / {A := Nat}` is the residual telescope, the same block with `A` no
-- longer a variable. That is worth having exactly because there is more than one
-- monoid on the naturals: what is proved here serves both of them, and a client
-- supplies only what is left. Sterling's Eckmann–Hilton example is this same
-- situation, a pair of monoids sharing one carrier.
module NatMonoid include Monoid / {A := Nat}
import Church

-- Discharged over the operation alone, since the carrier is no longer a field.
def fourth over (mul) : Nat → Nat := λ x ⇒ mul (mul x x) (mul x x)

-- * The two instances

-- Fixing every field leaves nothing to abstract over, which is what an instance
-- is. Note that `double` and `sq` have the very same body: what it means is
-- decided by the structure its module fixed, and neither takes an argument for
-- it.
module NatAdd
  include Monoid / {A := Nat, mul := plus, assoc := plusAssoc,
                    unit := zero, unitL := plusUnitL, unitR := plusUnitR}
import Church
def double : Nat → Nat := λ x ⇒ mul x x

module NatMul
  include Monoid / {A := Nat, mul := times, assoc := timesAssoc,
                    unit := one, unitL := timesUnitL, unitR := timesUnitR}
import Church
def sq : Nat → Nat := λ x ⇒ mul x x

-- * Using it all

module Client
import MonoidTheory
import Church
import NatMonoid
import NatAdd
import NatMul

-- One declaration, proved for every monoid on the naturals, applied to each of
-- the two structures in turn: 2+2+2+2 is 8, and 2·2·2·2 is 16.
compute fourth plus two
compute fourth times two

-- The instances' own declarations are plain constants, and mean different
-- things from the same body: 3+3 is 6, and 3·3 is 9.
compute double three
compute sq three

-- A lemma of the general theory, applied at an instance. `squareAssoc` was
-- closed over the carrier, the operation and associativity, so the instance's
-- own proof is the third argument, and the same lemma serves both structures.
check squareAssoc Nat plus plusAssoc
  : Π (x : Nat) → Id(Nat, plus (plus x x) x, plus x (plus x x))
check squareAssoc Nat times timesAssoc
  : Π (x : Nat) → Id(Nat, times (times x x) x, times x (times x x))

-- And one over a different set of fields again.
check unitSquare Nat plus zero plusUnitL
  : Π (x : Nat) → Id(Nat, plus zero (plus x x), plus x x)
