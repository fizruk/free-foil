comment "--" ;
comment "{-" "-}" ;

-- A dot inside an identifier is part of the identifier, so that @Nat.zero@ is
-- one token and the parser never has to decide whether a dot qualifies a name
-- or separates a binder from a body. That is why λ is written @λ x → e@ rather
-- than @λ x . e@: with both spellings of the dot in play, @λ x.x@ is ambiguous
-- at the lexical level, and no amount of grammar can recover it.
--
-- Resolution of a dotted identifier is not the parser's business at all; see
-- "Language.MLTT.Resolve".
token VarIdent letter (letter | digit | '_' | '\'' | '.')* ;

-- * Modules

-- A program is a sequence of modules. Normally each one is its own file, but
-- putting several in one file is convenient for tests and for a one-file demo.
AProgram. Program ::= [Module] ;
terminator Module "" ;

AModule.  Module ::= "module" VarIdent ";" [Import] [Decl] ;

AnImport. Import ::= "import" VarIdent ;
terminator Import ";" ;

-- * Declarations

DeclDef.        Decl ::= "def" VarIdent ":" Term ":=" Term ;
DeclPrivateDef. Decl ::= "private" "def" VarIdent ":" Term ":=" Term ;
DeclNamespace.  Decl ::= "namespace" VarIdent ";" [Decl] "end" ;
DeclOpen.       Decl ::= "open" VarIdent ;
DeclCheck.      Decl ::= "check" Term ":" Term ;
DeclCompute.    Decl ::= "compute" Term ;
terminator Decl ";" ;

-- * Terms
--
-- Binding constructs pair a Pattern field with the ScopedTerm it binds:
-- free foil's Template Haskell puts the binder inside the ScopedAST, so a
-- Pattern field contributes nothing to the signature node of its own.

Pi.       Term ::= "Π" "(" Pattern ":" Term ")" "→" ScopedTerm ;
Sigma.    Term ::= "Σ" "(" Pattern ":" Term ")" "×" ScopedTerm ;
Lam.      Term ::= "λ" Pattern "→" ScopedTerm ;
Let.      Term ::= "let" Pattern "=" Term "in" ScopedTerm ;
Arrow.    Term ::= Term1 "→" Term ;
Product.  Term ::= Term1 "×" Term ;

App.      Term1 ::= Term1 Term2 ;
First.    Term2 ::= "π₁" Term2 ;
Second.   Term2 ::= "π₂" Term2 ;

Universe. Term2 ::= "𝕌" ;
UnitType. Term2 ::= "𝟙" ;
UnitVal.  Term2 ::= "tt" ;
Var.      Term2 ::= VarIdent ;

IdType.   Term2 ::= "Id" "(" Term "," Term "," Term ")" ;
Refl.     Term2 ::= "refl" "(" Term ")" ;
J.        Term2 ::= "J" "(" Term "," Term "," Term ")" ;

Pair.     Term2 ::= "(" Term "," Term ")" ;
Ann.      Term2 ::= "(" Term ":" Term ")" ;

coercions Term 2 ;

AScopedTerm. ScopedTerm ::= Term ;

-- * Patterns

PatternWildcard. Pattern ::= "_" ;
PatternVar.      Pattern ::= VarIdent ;
PatternPair.     Pattern ::= "(" Pattern "," Pattern ")" ;
