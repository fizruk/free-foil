haskell/mltt/src/Language/MLTT/Syntax/*          linguist-generated=true
haskell/soas/src/Language/SOAS/Syntax/*          linguist-generated=true

# hpack, from the package.yaml beside them.
haskell/*/*.cabal linguist-generated=true
